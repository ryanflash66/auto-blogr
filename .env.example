# AutoBlogr Configuration
# ========================
# Copy this file to `.env.local` and fill in the values.

# Supabase (required for accounts + cloud data)
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The OpenRouter API key is not configured here. Each user saves their own on
# the Profile page (stored in their Supabase profile).
