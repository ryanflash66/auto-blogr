# AutoBlogr Configuration
# ========================
# Copy this file to `.env.local` and fill in the values.

# Supabase (required for accounts + cloud data)
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouter API Key (OPTIONAL - bring-your-own-key; can also be set per-user in
# the app once signed in). Get a free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
