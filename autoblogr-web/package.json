    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.56.1",
    "@wordpress/api-fetch": "^7.29.0",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.1",
