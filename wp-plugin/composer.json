{
    "name": "autoblogr/wp-api",
    "description": "AutoBlogr WordPress plugin exposing a signed REST API with asynchronous post processing.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "AutoBlogr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutoBlogr\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "*": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text"
    }
}
